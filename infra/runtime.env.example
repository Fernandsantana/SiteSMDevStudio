# Sem senhas. Preencher somente na futura publicacao autorizada.
SM_SITE_IMAGE=sha256:PREENCHER_ID_VALIDADO
SM_CONTACT_IMAGE=sha256:PREENCHER_ID_VALIDADO
SM_RELEASE_DIR=/opt/smdevstudio/releases/PREENCHER/public
SM_SMTP_SECRET_FILE=/etc/smdevstudio/secrets/smtp_password
CONTACT_ORIGINS=https://smdevstudio.com
# IPs/CIDRs reais dos proxies que sanitizam X-Forwarded-For; nunca 0.0.0.0/0.
SM_TRUSTED_PROXY_CIDRS=PREENCHER_PROXIES_VERIFICADOS
