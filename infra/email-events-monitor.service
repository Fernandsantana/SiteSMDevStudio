[Unit]
Description=Estado agregado de entregas de email
After=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /opt/entrada-produtos/coletar-eventos-email.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/entrada-produtos/monitor
TimeoutStartSec=25
